{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sense6.net/schemas/acutezza-validation-1.json",
  "title": "Sense6 Acutezza external-validation observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "protocolVersion",
    "devices",
    "sessions",
    "exceptions",
    "clinicalReview"
  ],
  "properties": {
    "format": { "const": "sense6-acutezza-validation" },
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": "1.0" },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "browser", "browserVersion", "os", "display"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "class": { "enum": ["phone", "tablet", "standard-monitor", "hidpi-monitor"] },
          "browser": { "enum": ["chromium", "firefox", "webkit"] },
          "browserVersion": { "type": "string", "maxLength": 40 },
          "os": { "type": "string", "maxLength": 80 },
          "display": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participantCode",
          "deviceId",
          "eye",
          "sequence",
          "correction",
          "distanceMm",
          "calibrationMethod",
          "sense6",
          "fract",
          "completedAt"
        ],
        "properties": {
          "participantCode": { "type": "string", "pattern": "^[A-Z0-9-]{1,24}$" },
          "deviceId": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "eye": { "enum": ["right", "left"] },
          "sequence": { "type": "integer", "minimum": 1, "maximum": 8 },
          "correction": { "enum": ["none", "glasses", "contacts"] },
          "distanceMm": { "type": "number", "exclusiveMinimum": 0 },
          "calibrationMethod": { "enum": ["measured", "assumed"] },
          "sense6": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "thresholdArcmin",
              "lowerArcmin",
              "upperArcmin",
              "bounded",
              "controlCorrect",
              "controlTotal"
            ],
            "properties": {
              "thresholdArcmin": { "type": "number", "exclusiveMinimum": 0 },
              "lowerArcmin": { "type": "number", "exclusiveMinimum": 0 },
              "upperArcmin": { "type": "number", "exclusiveMinimum": 0 },
              "bounded": { "type": "boolean" },
              "controlCorrect": { "type": "integer", "minimum": 0 },
              "controlTotal": { "type": "integer", "minimum": 0 }
            }
          },
          "fract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "trials", "logMar"],
            "properties": {
              "version": { "type": "string", "maxLength": 40 },
              "trials": { "type": "integer", "minimum": 1 },
              "logMar": { "type": "number" }
            }
          },
          "completedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantCode", "deviceId", "stage", "outcome", "reason", "occurredAt"],
        "properties": {
          "participantCode": { "type": "string", "pattern": "^[A-Z0-9-]{1,24}$" },
          "deviceId": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "stage": { "enum": ["acutezza", "fract", "between-methods", "retest"] },
          "outcome": {
            "enum": [
              "calibration-failure",
              "task-control-failure",
              "missing-result",
              "withdrawal",
              "adverse-event"
            ]
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "clinicalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewerRole", "reviewedAt", "findings"],
      "properties": {
        "status": { "enum": ["pending", "changes-requested", "accepted-nonclinical-boundary"] },
        "reviewerRole": { "type": ["string", "null"], "maxLength": 80 },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "findings": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    }
  }
}
