{
  "name": "sense6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, research-grounded browser perception lab.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/generate-static-pages.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "biome check src functions scripts tests playwright.config.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 --test-coverage-include='src/lib/*.js' tests/*.test.js",
    "test:static": "node --test tests/static-output.build.js",
    "test:e2e": "playwright test",
    "validate:acutezza": "node scripts/validate-acutezza-evidence.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run validate:acutezza && npm run build && npm run test:static && npm run test:e2e"
  },
  "dependencies": {
    "@ponchia/ui": "^0.6.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.55.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
