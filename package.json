{
  "name": "sense6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first collection of experimental browser perception tests.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "social:images": "node scripts/generate-social-images.mjs",
    "build": "vite build && node scripts/generate-static-pages.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "biome check src functions scripts tests audits playwright.config.js playwright.deployed.config.js playwright.site.config.js unlighthouse.config.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --clean --include='src/lib/*.js' --all --reporter=text --reporter=json-summary --reports-dir=coverage --check-coverage --lines=97 --branches=86 --functions=95 node --test tests/*.test.js && node scripts/check-coverage-report.mjs",
    "test:static": "node --test tests/static-output.build.js",
    "test:e2e": "playwright test",
    "test:deployed": "playwright test --config playwright.deployed.config.js",
    "test:deployed:local": "npm run build && npm run test:deployed",
    "test:html": "vnu --errors-only --skip-non-html dist",
    "test:links": "node scripts/check-internal-links.mjs",
    "test:site-integrity": "playwright test --config playwright.site.config.js audits/site-integrity.spec.js",
    "test:site-audit": "playwright test --config playwright.site.config.js audits/site-integrity.spec.js audits/experience-stability.spec.js",
    "test:visual:container": "playwright test --config playwright.site.config.js audits/visual-regression.spec.js --workers=1",
    "audit:lighthouse": "unlighthouse-ci --config-file unlighthouse.config.mjs && node scripts/check-lighthouse-metrics.mjs",
    "audit:site": "npm run build && npm run test:html && npm run test:links && npm run test:site-audit",
    "locales:generate": "node scripts/generate-locale-copy.mjs",
    "locales:check": "node scripts/generate-locale-copy.mjs --check && node scripts/check-locales.mjs",
    "docs:check": "node scripts/check-docs-lifecycle.mjs",
    "typecheck": "node scripts/check-type-ratchet.mjs && tsc -p jsconfig.json",
    "check:ui": "bronto-ui-check src functions scripts",
    "check:core": "npm run lint && npm run typecheck && npm run locales:check && npm run docs:check && npm run check:ui && npm run test:coverage && npm run build && npm run test:static",
    "check": "npm run check:core && npm run test:e2e",
    "check:release": "npm run check && npm run test:html && npm run test:links && npm run test:site-audit"
  },
  "dependencies": {
    "@ponchia/ui": "~0.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.55.0",
    "@unlighthouse/cli": "0.18.0",
    "c8": "12.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vnu-jar": "^26.7.16"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
