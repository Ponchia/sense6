{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client"]
  },
  "include": [
    "src/crawler-policy.js",
    "src/exams/contracts.js",
    "src/exams/landing.js",
    "src/exams/registry.js",
    "src/exams/views/**/*.js",
    "src/i18n.js",
    "src/i18n/**/*.js",
    "src/journal-copy.js",
    "src/lib/**/*.js",
    "src/locale-metadata.js",
    "src/locales.js",
    "src/locales/**/*.js",
    "src/metrics.js",
    "src/router.js",
    "src/**/*.d.ts"
  ]
}
