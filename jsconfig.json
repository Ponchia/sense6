{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client"]
  },
  "include": [
    "src/crawler-policy.js",
    "src/exams/contracts.js",
    "src/exams/landing.js",
    "src/exams/views/acutezza-intro.js",
    "src/exams/views/tetracromia-home.js",
    "src/i18n/catalog-audit.js",
    "src/i18n/message-ids.js",
    "src/journal-copy.js",
    "src/lib/journal.js",
    "src/lib/lifecycle.js",
    "src/lib/storage.js",
    "src/metrics.js"
  ]
}
